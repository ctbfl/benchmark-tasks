#usda 1.0
(
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Asset" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxContactReportAPI"]
)
{
    float physics:mass = 2.5
    float physxContactReport:threshold = 0

    def "Looks"
    {
        def Material "BlackEnclosure" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            token outputs:surface.connect = </Asset/Looks/BlackEnclosure/Shader.outputs:surface>
            float physics:dynamicFriction = 0.64
            float physics:restitution = 0
            float physics:staticFriction = 0.8

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.006, 0.007, 0.009)
                float inputs:metallic = 0
                float inputs:roughness = 0.72
                token outputs:surface
            }
        }

