#usda 1.0
(
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Asset" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysxContactReportAPI"]
)
{
    float physics:mass = 0.095
    float physxContactReport:threshold = 0

    def "Looks"
    {
        def Material "Nylon" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            token outputs:surface.connect = </Asset/Looks/Nylon/Shader.outputs:surface>
            float physics:dynamicFriction = 0.6
            float physics:restitution = 0
            float physics:staticFriction = 0.75

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.003, 0.004, 0.005)
                float inputs:metallic = 0
                float inputs:roughness = 0.85
                color3f inputs:specularColor = (0.01, 0.01, 0.01)
                int inputs:useSpecularWorkflow = 1
                token outputs:surface
            }
        }
    }

    def Mesh "blade" (
        prepend apiSchemas = ["PhysicsMeshCollisionAPI", "MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        int[] faceVertexCounts = [8, 8, 4, 4, 4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [7, 6, 5, 4, 3, 2, 1, 0, 8, 9, 10, 11, 12, 13, 14, 15, 0, 1, 9, 8, 1, 2, 10, 9, 2, 3, 11, 10, 3, 4, 12, 11, 4, 5, 13, 12, 5, 6, 14, 13, 6, 7, 15, 14, 7, 0, 8, 15]
        rel material:binding = </Asset/Looks/Nylon>
        rel material:binding:physics = </Asset/Looks/Nylon>
        uniform token physics:approximation = "convexHull"
        float physxCollision:contactOffset = 0.0003
        float physxCollision:restOffset = 0
        point3f[] points = [(-0.06, -0.037, 0), (-0.055, -0.044, 0), (0.025, -0.042, 0), (0.05, -0.021, 0), (0.05, 0.021, 0), (0.025, 0.042, 0), (-0.055, 0.044, 0), (-0.06, 0.037, 0), (-0.06, -0.037, 0.00035), (-0.055, -0.044, 0.000425), (0.025, -0.042, 0.001625), (0.05, -0.021, 0.002), (0.05, 0.021, 0.002), (0.025, 0.042, 0.001625), (-0.055, 0.044, 0.000425), (-0.06, 0.037, 0.00035)]
        uniform token subdivisionScheme = "none"
    }

    def Mesh "neck" (
        prepend apiSchemas = ["PhysicsMeshCollisionAPI", "MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [0, 2, 3, 1, 4, 5, 7, 6, 0, 1, 5, 4, 2, 6, 7, 3, 0, 4, 6, 2, 1, 3, 7, 5]
        rel material:binding = </Asset/Looks/Nylon>
        rel material:binding:physics = </Asset/Looks/Nylon>
        uniform token physics:approximation = "convexHull"
        float physxCollision:contactOffset = 0.0003
        float physxCollision:restOffset = 0
        point3f[] points = [(0.035, -0.012, 0.0005), (0.035, 0.012, 0.0005), (0.105, -0.012, 0.032), (0.105, 0.012, 0.032), (0.035, -0.012, 0.0065), (0.035, 0.012, 0.0065), (0.105, -0.012, 0.038), (0.105, 0.012, 0.038)]
        uniform token subdivisionScheme = "none"
    }

    def Mesh "handle" (
        prepend apiSchemas = ["PhysicsMeshCollisionAPI", "MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        int[] faceVertexCounts = [7, 7, 4, 4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [6, 5, 4, 3, 2, 1, 0, 7, 8, 9, 10, 11, 12, 13, 0, 1, 8, 7, 1, 2, 9, 8, 2, 3, 10, 9, 3, 4, 11, 10, 4, 5, 12, 11, 5, 6, 13, 12, 6, 0, 7, 13]
        rel material:binding = </Asset/Looks/Nylon>
        rel material:binding:physics = </Asset/Looks/Nylon>
        uniform token physics:approximation = "convexHull"
        float physxCollision:contactOffset = 0.0003
        float physxCollision:restOffset = 0
        point3f[] points = [(0.09, -0.014, 0.03), (0.22, -0.014, 0.03), (0.234, -0.007, 0.03), (0.237, 0, 0.03), (0.234, 0.007, 0.03), (0.22, 0.014, 0.03), (0.09, 0.014, 0.03), (0.09, -0.014, 0.045), (0.22, -0.014, 0.045), (0.234, -0.007, 0.045), (0.237, 0, 0.045), (0.234, 0.007, 0.045), (0.22, 0.014, 0.045), (0.09, 0.014, 0.045)]
        uniform token subdivisionScheme = "none"
    }
}

