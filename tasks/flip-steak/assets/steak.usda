                float2 inputs:in.connect = </Asset/Looks/Seared/UV.outputs:result>
                float2 inputs:scale = (0.495, 0.99)
                float2 inputs:translation = (0.5025, 0.005)
                float2 outputs:result
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @steak-atlas.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </Asset/Looks/Seared/Transform.outputs:result>
                color3f outputs:rgb
            }
        }
    }

