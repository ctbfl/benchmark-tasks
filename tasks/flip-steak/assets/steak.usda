    {
        def Material "Raw" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            token outputs:surface.connect = </Asset/Looks/Raw/Shader.outputs:surface>
            float physics:dynamicFriction = 0.32
            float physics:restitution = 0
            float physics:staticFriction = 0.4

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.5, 0.2, 0.15)
                color3f inputs:diffuseColor.connect = </Asset/Looks/Raw/Texture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.65
                token outputs:surface
            }

            def Shader "UV"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }

            def Shader "Transform"
            {
                uniform token info:id = "UsdTransform2d"
                float2 inputs:in.connect = </Asset/Looks/Raw/UV.outputs:result>
                float2 inputs:scale = (0.495, 0.99)
                float2 inputs:translation = (0.0025, 0.005)
                float2 outputs:result
            }

            def Shader "Texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @steak-atlas.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </Asset/Looks/Raw/Transform.outputs:result>
                color3f outputs:rgb
            }
        }

        def Material "Seared" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            token outputs:surface.connect = </Asset/Looks/Seared/Shader.outputs:surface>
