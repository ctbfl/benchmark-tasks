#usda 1.0
(
    defaultPrim = "tray"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "tray"
{
    def Material "Shell" (
        prepend apiSchemas = ["PhysicsMaterialAPI"]
    )
    {
        token outputs:surface.connect = </tray/Shell/Surface.outputs:surface>
        float physics:dynamicFriction = 0.255
        float physics:restitution = 0
        float physics:staticFriction = 0.3

        def Shader "Surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.055, 0.105, 0.14)
            float inputs:metallic = 0
            float inputs:roughness = 0.45
            token outputs:surface
        }
    }

