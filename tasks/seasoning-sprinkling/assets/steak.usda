#usda 1.0
(
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Asset"
{
    def "Looks"
    {
        def Material "roasted_beef" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            token outputs:surface.connect = </Asset/Looks/roasted_beef/Shader.outputs:surface>
            float physics:dynamicFriction = 0.5
            float physics:restitution = 0
            float physics:staticFriction = 0.65

            def Shader "Shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.5, 0.5, 0.5)
                color3f inputs:diffuseColor.connect = </Asset/Looks/roasted_beef/texture.outputs:rgb>
                float inputs:metallic = 0
                float inputs:roughness = 0.75
                token outputs:surface
            }

            def Shader "texture"
            {
                uniform token info:id = "UsdUVTexture"
                asset inputs:file = @steak.png@
                token inputs:sourceColorSpace = "sRGB"
                float2 inputs:st.connect = </Asset/Looks/roasted_beef/uv.outputs:result>
                float3 outputs:rgb
            }

            def Shader "uv"
            {
                uniform token info:id = "UsdPrimvarReader_float2"
                token inputs:varname = "st"
                float2 outputs:result
            }
        }
    }

