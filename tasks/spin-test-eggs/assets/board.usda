#usda 1.0
(
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)
def Xform "Asset" {

    def Material "Surface" (
        prepend apiSchemas = ["PhysicsMaterialAPI", "PhysxMaterialAPI"]
    ) {
        float physics:staticFriction = 0.0037
        float physics:dynamicFriction = 0.0037
        float physics:restitution = 0
        token physxMaterial:frictionCombineMode = "min"
    }

    def Cube "GlassTop" (prepend apiSchemas = ["PhysicsCollisionAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]) {
        double size = 2
        double3 xformOp:translate = (0.0, 0.0, 0.004)
        double3 xformOp:scale = (0.14, 0.155, 0.004)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        color3f[] primvars:displayColor = [(0.13, 0.19, 0.2)]
        
    float physxCollision:contactOffset = 0.00025
    float physxCollision:restOffset = 0
    float physxCollision:torsionalPatchRadius = 0
    float physxCollision:minTorsionalPatchRadius = 0
    rel material:binding:physics = </Asset/Surface>
    }
}
