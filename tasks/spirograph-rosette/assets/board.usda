#usda 1.0
(
    defaultPrim = "Object"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Object" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysxContactReportAPI"]
)
{
    bool physics:kinematicEnabled = 1
    float physxContactReport:threshold = 0
    int physxRigidBody:solverPositionIterationCount = 24
    int physxRigidBody:solverVelocityIterationCount = 4

    def "Materials"
    {
        def Material "Slate" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            token outputs:surface.connect = </Object/Materials/Slate/Surface.outputs:surface>
            float physics:dynamicFriction = 0.4
            float physics:restitution = 0
            float physics:staticFriction = 0.5

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.028, 0.09, 0.125)
                float inputs:opacity = 1
                float inputs:roughness = 0.38
                token outputs:surface
            }
        }

        def Material "Paper" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            token outputs:surface.connect = </Object/Materials/Paper/Surface.outputs:surface>
            float physics:dynamicFriction = 0.24
            float physics:restitution = 0
            float physics:staticFriction = 0.3

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.89, 0.86, 0.77)
                float inputs:opacity = 1
                float inputs:roughness = 0.79
                token outputs:surface
            }
        }

        def Material "Socket" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            token outputs:surface.connect = </Object/Materials/Socket/Surface.outputs:surface>
            float physics:dynamicFriction = 0.352
            float physics:restitution = 0
            float physics:staticFriction = 0.44

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.02, 0.031, 0.043)
                float inputs:opacity = 1
                float inputs:roughness = 0.38
                token outputs:surface
            }
        }

        def Material "Clips" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            token outputs:surface.connect = </Object/Materials/Clips/Surface.outputs:surface>
            float physics:dynamicFriction = 0.384
            float physics:restitution = 0
            float physics:staticFriction = 0.48

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.21, 0.3, 0.34)
                float inputs:opacity = 1
                float inputs:roughness = 0.24
                token outputs:surface
            }
        }
    }

    def Cube "DrawingBoard" (
        prepend apiSchemas = ["MaterialBindingAPI", "PhysicsCollisionAPI", "PhysxCollisionAPI"]
    )
    {
        rel material:binding = </Object/Materials/Slate>
        rel material:binding:physics = </Object/Materials/Slate>
        float physxCollision:contactOffset = 0.00023
        float physxCollision:restOffset = 0
        double size = 1
        float3 xformOp:scale = (0.254, 0.23, 0.01)
        double3 xformOp:translate = (0, 0, 0.005)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

