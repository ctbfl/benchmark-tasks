#usda 1.0
(
    defaultPrim = "Object"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Object" (
    prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysxRigidBodyAPI", "PhysxContactReportAPI", "PhysicsMassAPI"]
)
{
    point3f physics:centerOfMass = (0, 0, 0.0024)
    bool physics:kinematicEnabled = 0
    float physics:mass = 0.03
    float physxContactReport:threshold = 0
    int physxRigidBody:solverPositionIterationCount = 24
    int physxRigidBody:solverVelocityIterationCount = 4

    def "Materials"
    {
        def Material "WheelPlastic" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            token outputs:surface.connect = </Object/Materials/WheelPlastic/Surface.outputs:surface>
            float physics:dynamicFriction = 0.16
            float physics:restitution = 0
            float physics:staticFriction = 0.2

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.36, 0.74, 0.45)
                float inputs:opacity = 0.63
                float inputs:roughness = 0.38
                token outputs:surface
            }
        }

        def Material "ToothPlastic" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            token outputs:surface.connect = </Object/Materials/ToothPlastic/Surface.outputs:surface>
            float physics:dynamicFriction = 0.16
            float physics:restitution = 0
            float physics:staticFriction = 0.2

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.26, 0.64, 0.34)
                float inputs:opacity = 1
                float inputs:roughness = 0.38
                token outputs:surface
            }
        }

        def Material "BoreMarker" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            token outputs:surface.connect = </Object/Materials/BoreMarker/Surface.outputs:surface>
            float physics:dynamicFriction = 0.16
            float physics:restitution = 0
            float physics:staticFriction = 0.2

            def Shader "Surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.065, 0.36, 0.14)
                float inputs:opacity = 1
                float inputs:roughness = 0.38
                token outputs:surface
            }
        }
    }

