#usda 1.0
(
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Asset"
{
    def "materials"
    {
        def Material "face"
        {
            token outputs:surface.connect = </Asset/materials/face/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.72, 0.4, 0.22)
                float inputs:metallic = 0.9
                float inputs:roughness = 0.32
                token outputs:surface
            }
        }

        def Material "edge"
        {
            token outputs:surface.connect = </Asset/materials/edge/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.62, 0.33, 0.18)
                float inputs:metallic = 0.9
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        def Material "relief"
        {
            token outputs:surface.connect = </Asset/materials/relief/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.55, 0.29, 0.15)
                float inputs:metallic = 0.9
                float inputs:roughness = 0.3
                token outputs:surface
            }
        }
    }

