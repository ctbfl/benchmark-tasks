#usda 1.0
(
    defaultPrim = "Asset"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Asset"
{
    def "materials"
    {
        def Material "red_paper"
        {
            token outputs:surface.connect = </Asset/materials/red_paper/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.64, 0.018, 0.012)
                float inputs:metallic = 0
                float inputs:roughness = 0.92
                token outputs:surface
            }
        }
    }

    def Mesh "penny_0" (
        prepend apiSchemas = ["MaterialBindingAPI"]
    )
    {
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
