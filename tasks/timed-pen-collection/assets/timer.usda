    def "materials"
    {
        def Material "shell"
        {
            token outputs:surface.connect = </Asset/materials/shell/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.78, 0.81, 0.79)
                float inputs:metallic = 0
                float inputs:roughness = 0.4
                token outputs:surface
            }
        }

        def Material "dark"
        {
            token outputs:surface.connect = </Asset/materials/dark/shader.outputs:surface>

            def Shader "shader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.012, 0.018, 0.023)
                float inputs:metallic = 0
                float inputs:roughness = 0.65
                token outputs:surface
            }
        }

        def Material "rubber"
        {
            token outputs:surface.connect = </Asset/materials/rubber/shader.outputs:surface>

