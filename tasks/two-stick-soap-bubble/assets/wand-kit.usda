{
    def "Looks"
    {
        def Material "Plastic" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.3
            float physics:staticFriction = 0.38
        }

        def Material "Cotton" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.25
            float physics:staticFriction = 0.32
        }

        def Material "Silicone" (
            prepend apiSchemas = ["PhysicsMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 1.15
            float physics:staticFriction = 1.35
        }

        def Material "Solution"
        {
            token outputs:surface.connect = </Kit/Looks/Solution/surface.outputs:surface>

            def Shader "surface"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.065, 0.27, 0.29)
                float inputs:opacity = 0.76
                float inputs:roughness = 0.15
                token outputs:surface
            }
        }
    }

