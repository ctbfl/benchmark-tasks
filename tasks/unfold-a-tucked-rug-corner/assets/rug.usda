#usda 1.0
(
    defaultPrim = "Rug"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Rug"
{
    def Material "Pile"
    {
        token outputs:surface.connect = </Rug/Pile/Surface.outputs:surface>

        def Shader "Surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.13, 0.28, 0.22)
            color3f inputs:diffuseColor.connect = </Rug/Pile/Color.outputs:rgb>
            float inputs:roughness = 0.98
            token outputs:surface
        }

        def Shader "Coordinates"
        {
            uniform token info:id = "UsdPrimvarReader_float2"
            token inputs:varname = "st"
            float2 outputs:result
        }

        def Shader "Color"
        {
            uniform token info:id = "UsdUVTexture"
            asset inputs:file = @weave.png@
            token inputs:sourceColorSpace = "sRGB"
            float2 inputs:st.connect = </Rug/Pile/Coordinates.outputs:result>
            float3 outputs:rgb
        }
    }

    def Material "Backing"
    {
        token outputs:surface.connect = </Rug/Backing/Surface.outputs:surface>

        def Shader "Surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.32, 0.28, 0.2)
            float inputs:roughness = 0.98
            token outputs:surface
        }
    }

    def Material "Binding"
    {
        token outputs:surface.connect = </Rug/Binding/Surface.outputs:surface>

        def Shader "Surface"
        {
            uniform token info:id = "UsdPreviewSurface"
            color3f inputs:diffuseColor = (0.055, 0.1, 0.075)
            float inputs:roughness = 0.98
            token outputs:surface
        }
    }

    def Mesh "physics" (
        prepend apiSchemas = ["OmniPhysicsDeformableBodyAPI", "OmniPhysicsSurfaceDeformableSimAPI", "PhysicsCollisionAPI", "PhysxSurfaceDeformableBodyAPI", "PhysxCollisionAPI", "MaterialBindingAPI"]
    )
    {
